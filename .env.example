DATABASE_URL=mysql+pymysql://lextabularum:change-me@127.0.0.1/lextabularum?charset=utf8mb4
APP_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=https://tests.example.internal
SESSION_COOKIE_SECURE=true
SESSION_HOURS=12
EVIDENCE_DIR=./storage/evidence
MAX_UPLOAD_BYTES=10485760
# Local GitLab installations often use a private/self-signed CA. Set true when the CA is trusted.
GITLAB_VERIFY_SSL=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
GITLAB_RETRY_SECONDS=60
GITLAB_WEBHOOK_SECRET=
EVIDENCE_RETENTION_DAYS=365
LOG_LEVEL=INFO
GITLAB_OAUTH_URL=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
